@page "/register"

@using ShopSpree.Core.DTOs
@using ShopSpree.Core.Interfaces

@inject IUserService UserService
@inject NavigationManager Navigation

@rendermode InteractiveServer

<div class="auth-page">

    <div class="auth-card shadow">

        <h2 class="text-center mb-2">Create Account</h2>

        <p class="text-center text-muted mb-4">
            Join ShopSpree today
        </p>

        <EditForm Model="_model"
                  FormName="RegisterForm"
                  OnValidSubmit="RegisterUser">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <InputText class="form-control auth-input"
                           @bind-Value="_model.FirstName"
                           placeholder="First Name" />
            </div>

            <div class="mb-3">
                <InputText class="form-control auth-input"
                           @bind-Value="_model.LastName"
                           placeholder="Last Name" />
            </div>

            <div class="mb-3">
                <InputText class="form-control auth-input"
                           @bind-Value="_model.Email"
                           placeholder="Email" />
            </div>

            <!-- PASSWORD -->
            <div class="mb-3 position-relative">

                <InputText class="form-control auth-input"
                           @bind-Value="_model.Password"
                           type="@_passwordType"
                           placeholder="Password" />

                <button type="button"
                        class="toggle-password"
                        @onclick="TogglePassword">
                    @_passwordIcon
                </button>

            </div>

            <!-- CONFIRM PASSWORD -->
            <div class="mb-3 position-relative">

                <InputText class="form-control auth-input"
                           @bind-Value="_model.ConfirmPassword"
                           type="@_confirmPasswordType"
                           placeholder="Confirm Password" />

                <button type="button"
                        class="toggle-password"
                        @onclick="ToggleConfirmPassword">
                    @_confirmPasswordIcon
                </button>

            </div>

            <button type="submit"
                    class="btn btn-primary w-100 auth-btn">
                Create Account
            </button>

        </EditForm>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="text-center mt-3 text-danger">
                @_message
            </p>
        }

        <div class="text-center mt-3">
            <small>
                Already have an account?
                <a href="/login">Login</a>
            </small>
        </div>

    </div>

</div>

@code {

    private RegisterDto _model = new();
    private string? _message;

    // password toggle states
    private string _passwordType = "password";
    private string _confirmPasswordType = "password";

    private string _passwordIcon = "👁";
    private string _confirmPasswordIcon = "👁";

    private void TogglePassword()
    {
        if (_passwordType == "password")
        {
            _passwordType = "text";
            _passwordIcon = "🙈";
        }
        else
        {
            _passwordType = "password";
            _passwordIcon = "👁";
        }
    }

    private void ToggleConfirmPassword()
    {
        if (_confirmPasswordType == "password")
        {
            _confirmPasswordType = "text";
            _confirmPasswordIcon = "🙈";
        }
        else
        {
            _confirmPasswordType = "password";
            _confirmPasswordIcon = "👁";
        }
    }

    private async Task RegisterUser()
    {
        bool success =
            await UserService.RegisterAsync(_model);

        if (success)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _message = "Email already exists.";
    }
}