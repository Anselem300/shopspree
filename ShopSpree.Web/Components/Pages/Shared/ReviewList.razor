@using ShopSpree.Application.DTOs

@if (Reviews.Any())
{
    @foreach (var review in Reviews)
    {
        <div class="card mb-2">

            <div class="card-body">

                <h6>@review.ReviewerName</h6>

                <RatingStars Rating="@((int)review.Rating)" />

                <p>@review.Comment</p>

                <small>
                    @review.CreatedAt.ToShortDateString()
                </small>

            </div>

        </div>
    }
}

@code {

    [Parameter]
    public IEnumerable<ReviewDto> Reviews { get; set; } = [];

}