@using ShopSpree.Application.DTOs

<div class="card shadow-sm h-100">

    @if (Business.ImageUrls.Any())
    {
        <img src="@Business.ImageUrls.First()"
             class="card-img-top"
             alt="@Business.BusinessName" />
    }

    <div class="card-body">

        <h5>@Business.BusinessName</h5>

        <p>@Business.Description</p>

        <p>
            <strong>Location:</strong>
            @Business.City
        </p>

        <RatingStars Rating="@((int)Business.AverageRating)" />

        <NavLink href="@($"/businesses/{Business.Id}")"
                 class="btn btn-primary mt-2">
            View Details
        </NavLink>

    </div>

</div>

@code {

    [Parameter]
    public BusinessDto Business { get; set; } = default!;

}