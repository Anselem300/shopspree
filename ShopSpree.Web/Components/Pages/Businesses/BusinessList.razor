@page "/businesses"

@inject IBusinessService BusinessService

<PageTitle>Businesses</PageTitle>

<h3>Businesses</h3>

<SearchBar OnSearch="SearchBusinesses" />

@if (Businesses.Any())
{
    <div class="row">

        @foreach (var business in Businesses)
        {
            <div class="col-md-4 mb-4">
                <BusinessCard Business="business" />
            </div>
        }

    </div>
}
else
{
    <p>No businesses found.</p>
}

@code {

    private IEnumerable<BusinessDto> Businesses =
        new List<BusinessDto>();

    protected override async Task OnInitializedAsync()
    {
        Businesses =
            await BusinessService.GetAllAsync();
    }

    private async Task SearchBusinesses(string keyword)
    {
        Businesses =
            await BusinessService.SearchAsync(keyword);
    }
}