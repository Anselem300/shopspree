@page "/businesses/edit/{Id}"

@attribute [Authorize]

@inject IBusinessService BusinessService
@inject NavigationManager Navigation

<PageTitle>Edit Business</PageTitle>

@if (Model == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="Model"
              OnValidSubmit="SaveChanges">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <InputText class="form-control mb-2"
                   @bind-Value="Model.BusinessName" />

        <InputTextArea class="form-control mb-2"
                       @bind-Value="Model.Description" />

        <InputText class="form-control mb-2"
                   @bind-Value="Model.Address" />

        <InputText class="form-control mb-2"
                   @bind-Value="Model.City" />

        <button class="btn btn-primary">
            Save Changes
        </button>

    </EditForm>
}

@code {

    [Parameter]
    public string Id { get; set; } = string.Empty;

    private UpdateBusinessRequest? Model;

    protected override async Task OnInitializedAsync()
    {
        var business =
            await BusinessService.GetByIdAsync(Id);

        if (business == null)
            return;

        Model = new UpdateBusinessRequest
        {
            Id = business.Id,
            BusinessName = business.BusinessName,
            Description = business.Description,
            Address = business.Address,
            City = business.City
        };
    }

    private async Task SaveChanges()
    {
        if (Model == null)
            return;

        await BusinessService.UpdateAsync(Model);

        Navigation.NavigateTo("/dashboard");
    }
}