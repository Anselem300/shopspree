@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<PageTitle>ShopSpree | Discover Local Businesses</PageTitle>

<div class="home-page">

    <!-- HERO SECTION -->
    <section class="hero">

        <div class="hero-content">

            <h1>
                Discover Local Businesses.<br />
                Read Reviews. Connect Faster.
            </h1>

            <p>
                ShopSpree helps you explore trusted businesses in your community,
                compare ratings, and make better decisions with real user reviews.
            </p>

            <div class="hero-actions">

                <button class="btn btn-primary btn-lg"
                        @onclick="GoToLogin">
                    Sign In
                </button>

                <button class="btn btn-outline-primary btn-lg"
                        @onclick="GoToRegister">
                    Create Account
                </button>

            </div>

        </div>

        <div class="hero-image">
            <img src="/images/hero_image.png" alt="Businesses" />
        </div>

    </section>

    <!-- FEATURES -->
    <section class="features">

        <h2>Why ShopSpree?</h2>

        <div class="feature-grid">

            <div class="feature-card">
                <img src="/images/market.jpg" />
                <h4>Find Businesses</h4>
                <p>Discover restaurants, shops, and services near you instantly.</p>
            </div>

            <div class="feature-card">
                <img src="/images/review.jpg" />
                <h4>Read Reviews</h4>
                <p>Get honest feedback from real users before making decisions.</p>
            </div>

            <div class="feature-card">
                <img src="/images/xperience.jpg" />
                <h4>Share Experiences</h4>
                <p>Help others by reviewing businesses you’ve visited.</p>
            </div>

        </div>

    </section>

    <!-- CTA BANNER -->
    <section class="cta-banner">

        <h2>Join the ShopSpree Community Today</h2>

        <p>
            Unlock full access to businesses, reviews, and your personalized dashboard.
        </p>

        <button class="btn btn-light btn-lg"
                @onclick="GoToRegister">
            Get Started Free
        </button>

    </section>

</div>

@code {

    private async Task GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private async Task GoToRegister()
    {
        Navigation.NavigateTo("/register");
    }
}